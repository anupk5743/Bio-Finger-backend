# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Microsoft SQL Server Database Connection (Prisma)
# Configured for Windows Integrated Authentication
DATABASE_URL="sqlserver://localhost:1433;database=BioFingerDB;integratedSecurity=true;trustServerCertificate=true;"

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_bio_finger_2026_secure_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=super_secret_refresh_key_bio_finger_2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Device Bridge Configuration
MFS100_SERVICE_HOST=http://127.0.0.1:8004

# Seed Configuration (Initial Development Super Admin)
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=System
SEED_ADMIN_EMAIL=admin@biofinger.local
SEED_ADMIN_MOBILE=9000000001
SEED_ADMIN_PASSWORD=Admin@BioFinger2026!
