# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Microsoft SQL Server Database Connection (Prisma)
# Example for Windows Integrated Authentication:
DATABASE_URL="sqlserver://localhost:1433;database=BioFingerDB;integratedSecurity=true;trustServerCertificate=true;"
# Example for SQL Server Authentication:
# DATABASE_URL="sqlserver://localhost:1433;database=BioFingerDB;user=YOUR_USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true;"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
# In Vercel Environment Variables, set CLIENT_URL to your deployed frontend URL:
CLIENT_URL=https://bio-finger-frontend-1-roan.vercel.app,http://localhost:5173

# Device Bridge Configuration
MFS100_SERVICE_HOST=http://127.0.0.1:8004

# Seed Configuration (Placeholders)
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=System
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_MOBILE=9000000001
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
